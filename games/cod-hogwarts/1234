<script>
/* localStorage safety shim: if storage is blocked (opaque origin / privacy mode),
   fall back to in-memory so the game still boots instead of showing a blank page. */
(function(){
  var ok=false;
  try{ window.localStorage.setItem('__lwtest__','1'); window.localStorage.removeItem('__lwtest__'); ok=true; }catch(e){}
  if(ok) return;
  var mem={};
  var shim={
    getItem:function(k){return Object.prototype.hasOwnProperty.call(mem,k)?mem[k]:null;},
    setItem:function(k,v){mem[k]=String(v);},
    removeItem:function(k){delete mem[k];},
    clear:function(){mem={};},
    key:function(i){return Object.keys(mem)[i]||null;}
  };
  Object.defineProperty(shim,'length',{get:function(){return Object.keys(mem).length;}});
  try{ Object.defineProperty(window,'localStorage',{value:shim,configurable:true}); }
  catch(e){ try{ window.localStorage=shim; }catch(e2){} }
})();
</script>
