
:root{--bg:#08070a;--panel:#111018;--panel2:#17151f;--text:#e9e2f2;--muted:#8e839e;--line:#2a2535;--red:#e8354a;--gold:#c8a96e;--cyan:#00e5ff;--green:#ffb347;}
*{box-sizing:border-box;margin:0;padding:0}html,body{min-height:100%;background:radial-gradient(circle at 20% 10%,rgba(232,53,74,.12),transparent 30%),radial-gradient(circle at 80% 80%,rgba(0,229,255,.08),transparent 35%),var(--bg);color:var(--text);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Serif SC",sans-serif}body{padding:28px;overflow-x:hidden}.wrap{max-width:1100px;margin:0 auto}.eyebrow{font-size:12px;letter-spacing:6px;color:var(--red);margin-bottom:12px}.title{font-size:clamp(36px,8vw,76px);line-height:1;font-weight:800;letter-spacing:4px}.sub{margin-top:14px;color:var(--muted);line-height:1.8;max-width:760px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;margin-top:34px}.card{display:block;text-decoration:none;color:inherit;background:linear-gradient(145deg,rgba(255,255,255,.04),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:16px;padding:20px;min-height:180px;position:relative;overflow:hidden;transition:.2s}.card:hover{transform:translateY(-3px);border-color:var(--red);box-shadow:0 18px 50px rgba(0,0,0,.35)}.num{font-family:monospace;color:var(--muted);font-size:12px}.card h2{margin-top:22px;font-size:24px}.card p{margin-top:10px;color:var(--muted);line-height:1.6;font-size:14px}.tag{position:absolute;right:16px;bottom:16px;font-family:monospace;font-size:11px;color:var(--red);letter-spacing:2px}.footer{margin-top:34px;color:var(--muted);font-size:13px;line-height:1.8;border-top:1px solid var(--line);padding-top:18px}code{background:#15121d;border:1px solid var(--line);border-radius:6px;padding:2px 6px;color:var(--gold)}
